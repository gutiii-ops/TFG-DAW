# ==========================================
# GESTIÓN DE CONFIGURACIÓN Y SECRETOS (ENV)
# ==========================================

# ── Red y Entorno ──
PORT=8000
NODE_ENV=development

# ── Base de Datos (SQL Server) ──
DB_USER=sa
DB_PASSWORD=tu_password_fuerte
DB_SERVER=localhost
# Si usas una instancia (ej. .\SQLEXPRESS), el driver suele requerir config por IP y puerto, no el nombre local.
DB_NAME=GymMgmt
DB_PORT=1433

# ── Autenticación y Seguridad ──
# Clave generada para firmar los JSON Web Tokens (evita subir esto a repositorios públicos)
JWT_SECRET=generar_un_secreto_robusto_aqui_para_tfg_gymmgmt
